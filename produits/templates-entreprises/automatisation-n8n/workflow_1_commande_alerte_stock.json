    {
      "parameters": {
        "jsCode": "// Lit un nombre, même s'il arrive en texte (« 1 250 », « 12,5 »)\nfunction num(v) {\n  if (typeof v === 'number') return v;\n  if (v === undefined || v === null || v === '') return 0;\n  const s = String(v).replace(/\\s/g, '').replace(',', '.');\n  const n = parseFloat(s.replace(/[^0-9.\\-]/g, ''));\n  return isNaN(n) ? 0 : n;\n}\n\n// WhatsApp (modèles Meta) : pas de retour à la ligne ni de case vide dans les variables\nfunction wa(v) {\n  const s = String(v ?? '').replace(/[\\n\\r\\t]+/g, ' ').replace(/ {2,}/g, ' ').trim();\n  return s === '' ? '-' : s.slice(0, 900);\n}\n\nconst f = $('Formulaire de commande').first().json;\nconst code = String(f['Code produit'] || '').trim().toUpperCase();\nconst qte = num(f['Quantité']);\nif (qte <= 0) throw new Error('La quantité doit être supérieure à 0.');\n\nconst produit = $input.all().map(i => i.json)\n  .find(p => String(p['Code'] || '').trim().toUpperCase() === code);\nif (!produit) throw new Error(`Code produit inconnu : ${code}. Vérifiez l'onglet Produits.`);\n\nconst prixVente = num(produit['Prix de vente (1 unité)']);\nconst prixAchat = num(produit[\"Prix d'achat (1 unité)\"]);\nconst stockAvant = num(produit['Stock actuel']);\nconst seuil = num(produit[\"Seuil d'alerte\"]);\nconst stockApres = stockAvant - qte;\n\nreturn [{ json: {\n  // Colonnes de l'onglet Commandes (mêmes titres, même ordre)\n  'Date': $now.toFormat('yyyy-MM-dd HH:mm'),\n  'Client': f['Nom du client'],\n  'Téléphone': String(f['Téléphone du client']),\n  'Code produit': code,\n  'Produit': produit['Produit'],\n  'Quantité': qte,\n  'Prix unitaire': prixVente,\n  'Montant': qte * prixVente,\n  \"Coût d'achat\": qte * prixAchat,\n  'Statut': 'Nouvelle',\n  'Adresse': f['Adresse de livraison'] || '',\n  'Note': f['Note'] || '',\n  // Infos pour les alertes (pas écrites dans le tableau)\n  _stockAvant: stockAvant,\n  _stockApres: stockApres,\n  _seuil: seuil,\n  _unite: produit['Unité'] || '',\n  // Variables des messages WhatsApp\n  _wa: {\n    client: wa(f['Nom du client']),\n    tel: wa(f['Téléphone du client']),\n    produit: wa(produit['Produit']),\n    code: wa(code),\n    qte: wa(qte),\n    montant: wa(qte * prixVente),\n    adresse: wa(f['Adresse de livraison']),\n    stock: wa(`${stockApres} ${produit['Unité'] || ''}`),\n    seuil: wa(seuil),\n    etat: stockApres <= 0 ? 'Rupture de stock' : 'Stock bas',\n  },\n}}];\n"
      },
